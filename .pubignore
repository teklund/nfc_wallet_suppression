# ⚠️  This file SHADOWS the root .gitignore.
#
# From dart.dev/tools/pub/publishing: "If a directory contains both a
# .pubignore file and a .gitignore file, then `dart pub publish` ignores that
# directory's .gitignore file." So every root .gitignore rule that should also
# keep files out of the published archive has to be restated below — otherwise
# it silently stops applying at publish time. Nested .gitignore files
# (android/, example/, ios/, ...) are unaffected; only the root one is lost.
#
# Verify with `flutter pub publish --dry-run` and read the file tree, not just
# the warning count. Leaked build output produces zero warnings.

# Local build output. Without these the archive carries whatever happens to be
# in the publisher's working tree — `flutter test` alone leaves ~90 MB of
# .dill files in build/test_cache/.
build/
.dart_tool/
.gradle/
.cxx/

# IDE and OS cruft
*.iml
.idea/
.vscode/
.DS_Store

# CI config and generated reports — not useful to package consumers
.github/
coverage/
# The directory is `docs/`, not `doc/`. This rule read `doc/` and so matched
# nothing, which shipped the internal engineering notes to consumers and left
# pub warning about the plural directory name.
docs/

# Code generation source — consumers need the output, not the input
pigeons/

# Developer-only docs
PUBLISHING.md

# Binary files that trigger pub.dev warnings
example/android/gradle/wrapper/gradle-wrapper.jar
example/android/gradlew
example/android/gradlew.bat
